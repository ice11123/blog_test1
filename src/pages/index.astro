---
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, fmtNum } from '../consts';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import { parseMaintenance } from '../lib/maintenance';
import Layout from '../layouts/BlogPost.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import BlogList from '../components/blog/BlogList.astro';
import GitHubContributions from '../components/github/GitHubContributions.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import GitHubLanguages from '../components/github/GitHubLanguages.astro';
import PublicStatus from '../components/home/PublicStatus.astro';
import { withBase } from '../lib/urls';
import maintenanceSource from '../content/maintenance.md?raw';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
const maintenanceEntries = await parseMaintenance(maintenanceSource);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} pubDate={new Date()} sidebarsExpanded>
  <JsonLd slot="head" data={websiteLd} />

  <div class="home-width-container">
  <div class="home-page">
    <section class="home-panel home-overview-card">
      <section class="welcome">
        <h2 class="mk-title" style="display:inline;">你好！</h2>
        <h2 style="display:inline;">我是 {SITE_AUTHOR}</h2>
        <p>{SITE_DESCRIPTION}</p>
      </section>
      <h2 class="mk-title sr-only">数据统计</h2>
      <section class="site-stats">
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalArticles}</div><div class="stat-label">文章</div></div>
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalCategories}</div><div class="stat-label">分类</div></div>
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalTags}</div><div class="stat-label">标签</div></div>
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.daysSinceLaunch}</div><div class="stat-label">建站天数</div></div>
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{fmtNum(stats.totalWords)}</div><div class="stat-label">累计字数</div></div>
        <div class="stat-card fade-up-on-scroll"><div class="stat-number">{fmtNum(totalRepoLines)}</div><div class="stat-label">代码行数</div></div>
      </section>
    </section>

    <section class="recent-posts home-panel home-module">
      <h2 class="mk-title section-title">近期文章</h2>
      <BlogList sort="time" posts={recentPosts} />
      <a class="recent-more" href={withBase('/blog/')}>查看全部文章 →</a>
    </section>

    <section class="home-panel home-module home-repo-languages"><GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} /></section>
    <section class="home-panel home-module home-github-languages"><GitHubLanguages /></section>

    <section class="home-info-panel home-status-panel" aria-label="站点系统状态"><PublicStatus /></section>

    <section class="home-info-panel maintenance-panel" aria-label="近期博客维护公告">
      <div class="maintenance-heading">
        <p class="status-eyebrow">MAINTENANCE LOG</p>
        <h2>近期博客维护公告</h2>
      </div>
      <div class="maintenance-scroll">
        {maintenanceEntries.map((entry, index) => (
          <details class="maintenance-entry" open={index === 0}>
            <summary><time datetime={entry.date}>{entry.date}</time><span>{entry.title}</span></summary>
            <div class="maintenance-body" set:html={entry.html}></div>
          </details>
        ))}
      </div>
    </section>

    <section class="home-panel home-module contribution-panel"><GitHubContributions /></section>
  </div>
  </div>
</Layout>

<style>
  .home-width-container { width: 100%; min-width: 0; container-type: inline-size; }
  .home-page { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "overview" "recent" "repo" "github" "status" "maintenance" "contribution"; align-items: stretch; gap: .9rem; box-sizing: border-box; width: 100%; max-width: none; margin: 0 auto; padding: 1.25rem 1rem 2rem; text-align: center; }
  .home-page > * { min-width: 0; }
  .home-overview-card { grid-area: overview; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.15rem; text-align: center; }
  .welcome { width: 100%; margin-bottom: .85rem; text-align: center; }
  .welcome h2 { color: var(--foreground-light); font-size: 1.55rem; line-height: 1.35; }
  .welcome p { margin: .55rem 0 0; color: var(--foreground-dark); font-size: .92rem; line-height: 1.65; }
  .site-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .72rem; width: 100%; max-width: 32rem; margin: .9rem auto 0; }
  .stat-card { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: 5rem; padding: .72rem .45rem; text-align: center; background: rgba(var(--muted-rgb), .4); border: 1px solid var(--border); border-radius: var(--radius-xl); transition: transform .2s ease, border-color .2s ease; }
  /* 首页统计属于首屏核心信息，不应因滚动观察器尚未初始化而保持透明。 */
  .home-page .stat-card.fade-up-on-scroll { opacity: 1; transform: none; }
  .stat-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .stat-number { color: var(--accent-light); font-size: 1.55rem; font-weight: 700; line-height: 1.2; white-space: nowrap; }
  .stat-label { margin-top: .3rem; color: var(--foreground-dark); font-size: .76rem; }
  .section-title { margin: 0 0 .75rem; color: var(--foreground-light); font-size: 1.18rem; text-align: center; }
  .home-panel, .home-info-panel { overflow: hidden; background: color-mix(in srgb, var(--muted) 28%, transparent); border: 1px solid var(--border); border-radius: var(--radius-2xl); }
  .home-module { display: flex; flex-direction: column; }
  .home-module > :global(*) { flex: 1 1 auto; }
  .home-repo-languages { grid-area: repo; }
  .home-github-languages { grid-area: github; }
  .home-page :global(.lang-card), .home-page :global(.gh-contributions) { width: 100%; max-width: none; margin: 0; background: transparent; border: 0; border-radius: 0; }
  .home-page :global(.lang-card), .home-page :global(.gh-contributions) { display: flex; flex-direction: column; justify-content: center; }
  .home-page :global(.lang-card) { padding: 1rem; }
  .home-page :global(.lang-title), .home-page :global(.gh-contributions > .stat-label) { color: var(--foreground); font-size: .92rem; font-weight: 650; line-height: 1.4; }
  .home-page :global(.lang-chart-row) { gap: .75rem; }
  .home-page :global(.lang-pie) { width: 118px; height: 118px; }
  .home-page :global(.lang-legend) { gap: .2rem; font-size: .7rem; line-height: 1.35; }
  .home-page :global(.lang-total) { margin-top: .65rem; font-size: .72rem; }
  .home-page :global(.gh-grid-wrapper) { padding: .75rem; background: transparent; border: 0; border-radius: 0; }
  .recent-posts { grid-area: recent; display: flex; flex-direction: column; justify-content: flex-start; padding: 1rem; }
  .recent-posts :global(main) { width: 100%; max-width: 100%; margin: 0; padding: 0; }
  .recent-posts :global(.card-grid) { grid-template-columns: 1fr; gap: .55rem; margin: 0; }
  .recent-posts :global(.blog-card) { background: color-mix(in srgb, var(--background) 38%, transparent); border: 1px solid color-mix(in srgb, var(--border) 80%, transparent); }
  .recent-posts :global(.card-image) { display: none; }
  .recent-posts :global(.card-content) { gap: .25rem; padding: .6rem .7rem; }
  .recent-posts :global(.card-title) { font-size: .88rem; line-height: 1.35; }
  .recent-posts :global(.card-description) { font-size: .72rem; line-height: 1.45; -webkit-line-clamp: 2; }
  .recent-posts :global(.card-tags) { gap: .2rem; }
  .recent-posts :global(.card-tag) { padding-inline: .35rem; font-size: .62rem; }
  .recent-posts :global(.card-tag:nth-child(n + 3)) { display: none; }
  .recent-posts :global(.card-date) { font-size: .65rem; }
  .recent-more { align-self: center; margin-top: auto; padding-top: .7rem; color: var(--accent); font-size: .72rem; text-decoration: none; }
  .recent-more:hover { text-decoration: underline; }

  .home-info-panel { width: 100%; min-width: 0; box-sizing: border-box; padding: 1rem; }
  .home-status-panel { grid-area: status; }
  .maintenance-panel { grid-area: maintenance; display: flex; flex-direction: column; min-height: 0; }
  .maintenance-heading { margin-bottom: .7rem; }
  .maintenance-heading h2 { margin: .15rem 0 0; font-size: 1rem; }
  .maintenance-scroll { display: grid; grid-auto-rows: max-content; align-content: start; flex: 1 1 auto; gap: .5rem; min-height: 0; max-height: 20rem; padding-right: .2rem; overflow-y: auto; scrollbar-gutter: stable; scrollbar-width: thin; }
  .maintenance-entry { overflow: hidden; padding: 0; margin: 0; background: color-mix(in srgb, var(--background) 42%, transparent); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .maintenance-entry[open] { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .maintenance-entry summary { position: relative; display: grid; gap: .18rem; padding: .65rem .72rem .65rem 1.05rem; margin: 0; color: var(--foreground); cursor: pointer; list-style: none; }
  .maintenance-entry[open] > summary { margin-bottom: 0; }
  .maintenance-entry summary::-webkit-details-marker { display: none; }
  .maintenance-entry summary::before { content: '›'; position: absolute; left: .45rem; top: .72rem; color: var(--accent); transform: rotate(0deg); transition: transform var(--transition-base); }
  .maintenance-entry[open] summary::before { transform: rotate(90deg); }
  .maintenance-entry summary time { color: var(--accent); font-size: .66rem; font-weight: 650; }
  .maintenance-entry summary span { padding-left: .35rem; font-size: .78rem; font-weight: 650; line-height: 1.45; }
  .maintenance-body { padding: 0 .8rem .75rem; color: var(--foreground-dark); font-size: .72rem; line-height: 1.65; }
  .maintenance-body :global(p), .maintenance-body :global(ul) { margin: .45rem 0 0; }
  .maintenance-body :global(ul) { padding-left: 1.2rem; }
  .contribution-panel { grid-area: contribution; padding: .85rem 1rem; }

  @container (min-width: 680px) {
    .home-page { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "overview recent" "repo github" "status maintenance" "contribution contribution"; }
    .maintenance-scroll { max-height: 15rem; }
  }

  @container (min-width: 1040px) {
    .home-page { width: calc(100% + 2em); margin-left: -1em; grid-template-columns: repeat(2, minmax(0, 1fr)) 320px; grid-template-areas: "overview recent status" "repo github maintenance" "contribution contribution contribution"; gap: .75rem; padding-inline: 0; }
  }

  @container (min-width: 1120px) {
    .home-page { grid-template-columns: repeat(2, minmax(0, 1fr)) 380px; gap: 1rem; }
  }

  @media (max-width: 760px) {
    .home-page { padding-inline: .75rem; }
    .site-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
    .stat-card { min-height: 4.7rem; padding: .8rem .6rem; }
    .stat-number { font-size: 1.45rem; }
    .home-info-panel { padding: .85rem; }
  }
  @media (max-width: 420px) {
    .site-stats { gap: .6rem; }
    .stat-card { padding: .8rem .5rem; }
    .stat-number { font-size: 1.35rem; }
  }
</style>
