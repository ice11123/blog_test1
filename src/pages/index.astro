---
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, fmtNum } from '../consts';
import { computeSiteStats } from '../lib/blogStats';
import { getRepoLanguages } from '../lib/repoStats';
import Layout from '../layouts/BlogPost.astro';
import JsonLd from '../components/blog/JsonLd.astro';
import BlogList from '../components/blog/BlogList.astro';
import GitHubContributions from '../components/github/GitHubContributions.astro';
import MonthlyChart from '../components/github/MonthlyChart.astro';
import GitHubRepoStats from '../components/github/GitHubRepoStats.astro';
import GitHubLanguages from '../components/github/GitHubLanguages.astro';
import { withBase } from '../lib/urls';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: new URL(withBase('/'), Astro.site).href,
};

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const stats = computeSiteStats(allPosts);
const { repoLanguages, totalRepoLines } = getRepoLanguages();
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  pubDate={new Date()}
  fullWidth
>
  <JsonLd slot="head" data={websiteLd} />

  <div class="home-page">
    <section class="home-pair home-overview-grid">
      <div class="home-overview-copy">
        <section class="welcome">
          <h2 class="mk-title" style="display:inline;">你好！</h2>
          <h2 style="display:inline;">我是 {SITE_AUTHOR}</h2>
          <p>{SITE_DESCRIPTION}</p>
        </section>
        <h2 class="mk-title sr-only">数据统计</h2>
        <section class="site-stats">
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalArticles}</div><div class="stat-label">文章</div></div>
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalCategories}</div><div class="stat-label">分类</div></div>
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.totalTags}</div><div class="stat-label">标签</div></div>
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{stats.daysSinceLaunch}</div><div class="stat-label">建站天数</div></div>
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{fmtNum(stats.totalWords)}</div><div class="stat-label">累计字数</div></div>
          <div class="stat-card fade-up-on-scroll"><div class="stat-number">{fmtNum(totalRepoLines)}</div><div class="stat-label">代码行数</div></div>
        </section>
      </div>
      <div class="home-module"><MonthlyChart labels={stats.monthLabels} counts={stats.monthCounts} /></div>
    </section>

    <section class="home-pair home-language-grid">
      <div class="home-module"><GitHubRepoStats languages={repoLanguages} totalLines={totalRepoLines} /></div>
      <div class="home-module"><GitHubLanguages /></div>
    </section>

    <section class="home-pair home-community-grid">
      <div class="home-module"><GitHubContributions /></div>
      <section class="recent-posts home-module">
        <h2 class="mk-title section-title">近期文章</h2>
        <BlogList sort="time" posts={recentPosts} />
      </section>
    </section>
  </div>
</Layout>

<style>
  .home-page {
    max-width: 1320px;
    margin: 0 auto;
    padding: 2rem 1rem;
    text-align: center;
  }

  :global(.three-col-layout.full-width-layout > .left-sidebar),
  :global(.three-col-layout.full-width-layout > .right-sidebar),
  :global(.three-col-layout.full-width-layout > .sidebar-gutter) { display: none; }
  :global(.three-col-layout.full-width-layout > .content-main) { width: 100%; flex-basis: 100%; }

  .welcome {
    margin-bottom: 1.25rem;
  }

  .welcome h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--foreground-light);
  }

  .welcome p {
    color: var(--foreground-dark);
    font-size: 1.1rem;
  }

  /* 站点统计卡片 — 3 列网格 */
  .site-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.5rem auto 0;
    max-width: none;
  }

  .stat-card {
    background: rgba(var(--muted-rgb), 0.4);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.15rem .75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--accent-light);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--foreground-dark);
    margin-top: 0.3rem;
  }

  .section-title {
    font-size: 1.4rem;
    margin: 0 0 1rem;
    color: var(--foreground-light);
    text-align: center;
  }

  .home-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 1.25rem; margin-bottom: 1.25rem; min-width: 0; text-align: left; }
  .home-pair > * { min-width: 0; }
  .home-overview-copy, .home-module, .recent-posts { height: 100%; min-width: 0; }
  .home-overview-copy { display: flex; flex-direction: column; justify-content: center; padding: 1.25rem; }
  .home-module > :global(*) { height: 100%; }
  .home-page :global(.monthly-chart-card),
  .home-page :global(.lang-card),
  .home-page :global(.gh-contributions) { width: 100%; max-width: none; height: 100%; margin: 0; }
  .home-page :global(.monthly-chart-card), .home-page :global(.lang-card) { display: flex; flex-direction: column; justify-content: center; }
  .home-page :global(.gh-contributions) { display: flex; flex-direction: column; justify-content: center; }
  .home-community-grid { grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr); }
  .recent-posts { display: flex; flex-direction: column; justify-content: center; padding: 1rem; }
  .recent-posts :global(.card-grid) { grid-template-columns: 1fr; margin: 0; }

  @media (max-width: 900px) {
    .home-pair, .home-community-grid { grid-template-columns: 1fr; }
    .home-overview-copy { padding: .5rem 0; }
    .recent-posts { padding: 0; }
  }

  @media (max-width: 760px) {
    .site-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .stat-card {
      padding: 1rem 0.8rem;
    }

    .stat-number {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 420px) {
    .site-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }

    .stat-card {
      padding: 0.8rem 0.5rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }
  }
</style>
