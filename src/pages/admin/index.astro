---
import { getCollection } from 'astro:content';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HtmlHead from '../../components/layout/HtmlHead.astro';
import { ADMIN_SYNC_API_URL, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import type { AdminPostDraft } from '../../lib/adminDrafts';
import { resolveDirs } from '../../lib/utils';

const posts = await getCollection('blog');
const initialDrafts: AdminPostDraft[] = posts.map((post) => {
  const dirs = resolveDirs(post);
  const format = post.id.endsWith('.md') ? 'md' : 'mdx';
  const publishedId = /\.(?:md|mdx)$/i.test(post.id) ? post.id : `${post.id}.${format}`;
  return {
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate.toISOString().slice(0, 10),
    updatedDate: post.data.updatedDate?.toISOString().slice(0, 10),
    dir1: dirs.dir1,
    dir2: dirs.dir2,
    tags: post.data.tags ?? [],
    body: post.body ?? '',
    format,
    publishedPath: `src/content/blog/${publishedId}`,
    localEditedAt: undefined,
  };
});
---

<html lang="zh-cn">
  <head>
    <HtmlHead title={`管理台 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body class="admin-page">
    <Header />
    <main class="admin-shell">
      <section class="admin-hero">
        <p class="admin-kicker">ADMIN PROTOTYPE</p>
        <h1>博客管理台</h1>
        <p>这里可以编辑文章、标签和目录，保存本地草稿，并通过 GitHub 授权发布到正式网站。</p>
        <div class="admin-warning" role="note">
          安全提示：隐藏入口和站内密码只是界面门槛，真正的发布权限由云端 GitHub OAuth、HttpOnly 会话、Origin 与 CSRF 校验共同控制。本地草稿仍只保存在当前浏览器。
        </div>
      </section>

      <section id="admin-app" data-initial-drafts={JSON.stringify(initialDrafts)} data-sync-endpoint={ADMIN_SYNC_API_URL}>
        <div class="admin-locked" data-locked>
          <h2>管理台已锁定</h2>
          <p>请从顶部站名连续点击 5 次，再输入管理密码。</p>
          <button type="button" class="unlock-button" data-admin-open>输入管理密码</button>
        </div>
        <div class="admin-editor" data-editor hidden>
          <div class="admin-toolbar">
            <div>
              <strong data-status>未保存</strong>
              <span class="admin-muted" data-count></span>
            </div>
            <div class="admin-actions">
              <button type="button" data-new>新建文章</button>
              <button type="button" data-reset>恢复仓库初始内容</button>
              <button type="button" data-export>导出当前文件</button>
              <button type="button" class="sync-button" data-cloud-publish disabled={!ADMIN_SYNC_API_URL} title={ADMIN_SYNC_API_URL ? '通过云端 API 提交到 GitHub 并触发部署' : '尚未配置云端 API'}>发布到正式网站</button>
            </div>
          </div>

          <div class="admin-layout">
            <aside class="admin-list" aria-label="文章列表">
              <label class="admin-search-label" for="admin-search">筛选文章</label>
              <input id="admin-search" type="search" placeholder="标题、标签或分类" data-search />
              <div data-post-list></div>
            </aside>

            <form class="admin-form" data-form>
              <div class="form-grid">
                <label>标题<input name="title" required /></label>
                <label>发布日期<input name="pubDate" type="date" required /></label>
                <label class="wide">描述<textarea name="description" rows="2" required></textarea></label>
                <label>一级目录<input name="dir1" placeholder="例如：开始" /></label>
                <label>二级目录<input name="dir2" placeholder="可选" /></label>
                <label class="wide">标签<input name="tags" placeholder="用逗号分隔，例如：Astro, 演示" /></label>
                <label>文件格式<select name="format"><option value="mdx">MDX</option><option value="md">Markdown</option></select></label>
                <label>草稿 ID<input name="id" readonly /></label>
              </div>
              <label class="body-label">正文（Markdown / MDX）<textarea name="body" rows="22" required></textarea></label>
              <div class="form-actions">
                <button type="submit" class="primary">保存本地草稿</button>
                <button type="button" data-delete>删除当前草稿</button>
                <span class="edited-at" data-edited-at>尚未修改</span>
              </div>
              <p class="sync-hint" data-sync-hint>{ADMIN_SYNC_API_URL ? '首次发布会跳转 GitHub 授权；授权账号必须是 ice11123。' : '尚未配置云端 API。配置后可从任意设备登录 GitHub 并一键发布。'}</p>
            </form>

            <article class="admin-preview" aria-live="polite">
              <div class="preview-heading"><span>实时预览</span><span class="admin-muted">基础 Markdown 预览</span></div>
              <div class="preview-body" data-preview></div>
            </article>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .admin-page { --admin-accent: #4f46e5; --admin-surface: color-mix(in srgb, var(--background) 96%, #64748b); --admin-panel: color-mix(in srgb, var(--background-dark) 94%, var(--background)); --admin-line: color-mix(in srgb, var(--foreground) 14%, transparent); --admin-ink: var(--foreground); background: var(--admin-surface); }
  .admin-shell { width: min(1840px, calc(100% - 2rem)); margin: 0 auto 3rem; }
  .admin-hero { max-width: 850px; margin: 1rem auto 1.5rem; }
  .admin-kicker { margin: 0; color: var(--accent); font-size: 0.72rem; letter-spacing: 0.16em; }
  .admin-hero h1 { margin: 0.2rem 0 0.5rem; }
  .admin-hero > p:not(.admin-kicker) { margin: 0 0 1rem; }
  .admin-warning { padding: 0.85rem 1rem; border: 1px solid color-mix(in srgb, var(--admin-accent) 24%, var(--admin-line)); border-radius: 10px; background: color-mix(in srgb, var(--admin-accent) 7%, var(--admin-panel)); color: var(--admin-ink); font-size: 0.86rem; line-height: 1.55; }
  .admin-locked { max-width: 520px; margin: 3rem auto; padding: 2rem; text-align: center; border: 1px solid var(--admin-line); border-radius: 16px; background: var(--admin-panel); box-shadow: 0 12px 32px color-mix(in srgb, #172033 8%, transparent); }
  .unlock-button { margin-top: 1rem; min-height: 2.4rem; padding: 0.55rem 1rem; border: 0; border-radius: 9px; color: #fff; background: var(--admin-accent); font: inherit; font-weight: 650; cursor: pointer; transition: filter .18s ease, transform .18s ease; }
  .unlock-button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .admin-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; padding: 0.9rem 1.1rem; border: 1px solid var(--admin-line); border-radius: 14px; background: var(--admin-panel); box-shadow: 0 8px 24px color-mix(in srgb, #172033 7%, transparent); }
  .admin-actions, .form-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .admin-actions button, .form-actions button, .admin-toolbar button { min-height: 2.25rem; padding: 0.5rem 0.8rem; border: 1px solid var(--admin-line); border-radius: 9px; color: var(--admin-ink); background: var(--admin-surface); cursor: pointer; transition: border-color .18s ease, background .18s ease, transform .18s ease; }
  .admin-actions button:hover, .form-actions button:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--background)); transform: translateY(-1px); }
  .admin-actions .primary, .form-actions .primary { color: #fff; background: var(--admin-accent); border-color: var(--admin-accent); }
  .sync-button { color: var(--background) !important; background: color-mix(in srgb, var(--accent) 80%, #22c55e) !important; border-color: transparent !important; font-weight: 650; }
  .sync-button:disabled { opacity: .58; cursor: not-allowed; transform: none !important; }
  .admin-layout { display: grid; grid-template-columns: 280px minmax(560px, 1.2fr) minmax(520px, 1fr); gap: 1.15rem; align-items: start; }
  .admin-list, .admin-form, .admin-preview { min-width: 0; padding: 1.15rem; border: 1px solid var(--admin-line); border-radius: 14px; background: var(--admin-panel); box-shadow: 0 8px 24px color-mix(in srgb, #172033 5%, transparent); }
  .admin-list { position: sticky; top: 1rem; }
  .admin-search-label, .body-label, .admin-form label { display: grid; gap: 0.35rem; font-size: 0.82rem; }
  .admin-search-label { margin-bottom: 0.35rem; }
  .admin-list input, .admin-form input, .admin-form textarea, .admin-form select { width: 100%; box-sizing: border-box; padding: 0.65rem 0.72rem; color: var(--admin-ink); background: var(--admin-surface); border: 1px solid var(--admin-line); border-radius: 9px; font: inherit; font-size: 0.9rem; outline: none; transition: border-color .18s ease, box-shadow .18s ease; }
  .admin-list input:focus, .admin-form input:focus, .admin-form textarea:focus, .admin-form select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .admin-form textarea { resize: vertical; line-height: 1.5; }
  .admin-form textarea[name="body"] { min-height: 540px; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.86rem; }
  .admin-form input[readonly] { opacity: 0.65; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .form-grid .wide { grid-column: 1 / -1; }
  .body-label { margin-top: 0.85rem; }
  .form-actions { margin-top: 0.85rem; }
  .edited-at { align-self: center; margin-left: auto; color: var(--foreground-dark); font-size: 0.78rem; }
  .sync-hint { margin: 0.7rem 0 0; color: var(--foreground-dark); font-size: 0.78rem; line-height: 1.5; }
  .admin-post-item { display: grid; gap: 0.1rem; width: 100%; margin-top: 0.5rem; padding: 0.6rem; text-align: left; color: var(--foreground); background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer; }
  .admin-post-item:hover, .admin-post-item.active { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .admin-post-item small { opacity: 0.65; font-size: 0.72rem; }
  .preview-heading { display: flex; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.75rem; font-size: 0.85rem; }
  .preview-body { min-height: 360px; line-height: 1.7; overflow-wrap: anywhere; }
  .preview-body h1, .preview-body h2, .preview-body h3 { margin: 1rem 0 0.5rem; }
  .preview-body p { margin: 0.7rem 0; }
  .preview-body pre { overflow-x: auto; padding: 0.75rem; background: var(--background-dark); border-radius: 8px; }
  .preview-body code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
  .admin-muted { opacity: 0.65; font-size: 0.78rem; }
  @media (max-width: 1050px) { .admin-layout { grid-template-columns: 190px minmax(320px, 1fr); } .admin-preview { grid-column: 1 / -1; } }
  @media (max-width: 720px) { .admin-shell { width: min(100% - 1rem, 680px); } .admin-toolbar { align-items: stretch; flex-direction: column; padding: .8rem; } .admin-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); } .admin-actions button { width: 100%; } .admin-layout { display: block; } .admin-list, .admin-form, .admin-preview { position: static; margin-bottom: 1rem; padding: .85rem; } .form-grid { grid-template-columns: 1fr; } .form-grid .wide { grid-column: auto; } .edited-at { width: 100%; margin-left: 0; } .admin-form textarea[name="body"] { min-height: 420px; } }
</style>

<script>
  // @ts-nocheck -- 管理台原型脚本运行时由 DOM 约束保护。
  import { marked } from 'marked';

  const ADMIN_UNLOCK_STORAGE_KEY = 'blog-test1-admin-unlocked';
  const PENDING_CLOUD_PUBLISH_KEY = 'blog-test1-pending-cloud-publish-v1';
  const PENDING_CLOUD_DELETE_KEY = 'blog-test1-pending-cloud-delete-v1';
  const LEGACY_ADMIN_SESSION_KEY = 'blog-test1-cloud-session-v1';

  const STORAGE_KEY = 'blog-test1-admin-drafts-v1';
  const normalizePublishedPath = (post) => {
    if (typeof post.publishedPath !== 'string' || !post.publishedPath) return { ...post };
    const path = post.publishedPath.replaceAll('\\', '/');
    const parts = path.split('/');
    if (!path.startsWith('src/content/blog/') || parts.some((part) => !part || part === '.' || part === '..')) return { ...post, publishedPath: undefined };
    if (/\.(?:md|mdx)$/i.test(path)) return { ...post, publishedPath: path };
    if (!/^[^/]+(?:\/[^/]+)*$/.test(path.slice('src/content/blog/'.length))) return { ...post, publishedPath: undefined };
    return { ...post, publishedPath: `${path}.${post.format === 'md' ? 'md' : 'mdx'}` };
  };
  const clonePost = (post) => ({ ...normalizePublishedPath(post), tags: [...(post.tags || [])] });
  const app = document.querySelector('#admin-app');
  const initialDrafts = app ? JSON.parse(app.getAttribute('data-initial-drafts') || '[]') : [];
  const readDrafts = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : null;
      if (!Array.isArray(parsed)) return initialDrafts.map(clonePost);
      const initial = initialDrafts.map(clonePost);
      const initialIds = new Set(initial.map(post => post.id));
      const initialPaths = new Set(initial.map(post => post.publishedPath).filter(Boolean));
      const merged = initial.map(post => {
        const local = parsed.find(item => item.id === post.id || (item.publishedPath && item.publishedPath === post.publishedPath));
        return local ? clonePost({ ...post, ...local, orphaned: false, repositoryPending: false }) : post;
      });
      for (const item of parsed) {
        const post = clonePost(item);
        if (initialIds.has(post.id) || (post.publishedPath && initialPaths.has(post.publishedPath))) continue;
        if (post.deleted) continue;
        merged.push({ ...post, orphaned: Boolean(post.publishedPath) && !post.repositoryPending });
      }
      return merged;
    } catch { return initialDrafts.map(clonePost); }
  };
  const writeDrafts = (posts) => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(posts)); } catch {} };
  const saveDraft = (post) => writeDrafts([...readDrafts().filter(item => item.id !== post.id), clonePost(post)]);
  const removeDraft = (id) => writeDrafts(readDrafts().filter(post => post.id !== id));
  const resetDrafts = () => { try { localStorage.removeItem(STORAGE_KEY); } catch {} };
  const slugifyAdminId = (title) => `draft/${title.trim().toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, '-').replace(/^-+|-+$/g, '') || 'untitled'}-${Date.now()}`;
  const draftToMarkdown = (post) => ['---', `title: ${JSON.stringify(post.title)}`, `description: ${JSON.stringify(post.description)}`, `pubDate: ${post.pubDate}`, ...(post.dir1 ? [`dir1: ${JSON.stringify(post.dir1)}`] : []), ...(post.dir2 ? [`dir2: ${JSON.stringify(post.dir2)}`] : []), `tags: [${post.tags.map(tag => JSON.stringify(tag)).join(', ')}]`, '---', '', post.body.trim(), ''].join('\\n');

  if (app) {
    let drafts = readDrafts();
    let selectedId = drafts[0]?.id || '';
    const editor = app.querySelector('[data-editor]');
    const locked = app.querySelector('[data-locked]');
    const form = app.querySelector('[data-form]');
    const list = app.querySelector('[data-post-list]');
    const preview = app.querySelector('[data-preview]');
    const status = app.querySelector('[data-status]');
    const count = app.querySelector('[data-count]');
    const field = (name) => form?.querySelector(`[name="${name}"]`);
    const escapeHtml = (value) => value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    let previewTimer;
    let editedAt = '';
    const formatEditedAt = (value) => value ? `最新修改于 ${new Date(value).toLocaleString('zh-CN', { hour12: false })}` : '尚未修改';
    const renderMarkdown = (value) => {
      let source = value.replace(/^---[\s\S]*?---\s*/m, '').replace(/^\s*(import|export)\s+.*$/gm, '');
      source = source.replace(/<([A-Z][\w]*)\b[^>]*\/>/g, (_, name) => `\n[组件预览：${name}]\n`);
      source = source.replace(/<([A-Z][\w]*)\b[^>]*>[\s\S]*?<\/\1>/g, (_, name) => `\n[组件预览：${name}]\n`);
      source = source.replace(/\$\$([\s\S]*?)\$\$/g, (_, math) => `\n[数学公式] ${math.trim()}\n`);
      source = source.replace(/(?<!\$)\$([^$\n]+)\$(?!\$)/g, (_, math) => `[行内公式：${math.trim()}]`);
      const renderer = new marked.Renderer();
      renderer.html = ({ text }) => escapeHtml(text);
      const safeUrl = (value) => /^(?:https?:|mailto:|\/|#)/i.test(String(value || '')) ? String(value) : '';
      renderer.link = ({ href, title, text }) => {
        const url = safeUrl(href);
        const label = escapeHtml(text || href || '链接');
        if (!url) return label;
        const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
        return `<a href="${escapeHtml(url)}"${titleAttr} rel="noopener noreferrer">${label}</a>`;
      };
      renderer.image = ({ href, title, text }) => {
        const url = safeUrl(href);
        if (!url) return escapeHtml(text || '图片');
        const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
        return `<img src="${escapeHtml(url)}" alt="${escapeHtml(text || '')}"${titleAttr} loading="lazy" />`;
      };
      return marked.parse(source, { breaks: true, gfm: true, async: false, renderer });
    };
    const setStatus = (text) => { if (status) status.textContent = text; };
    const endpoint = () => (app.getAttribute('data-sync-endpoint') || '').replace(/\/$/, '');
    let csrfToken = '';
    const authHeaders = () => csrfToken ? { 'X-CSRF-Token': csrfToken } : {};
    const publishPost = async (post, button) => {
      const api = endpoint();
      if (!api) { setStatus('尚未配置云端 API'); return false; }
      if (post.orphaned) { setStatus('该草稿对应的仓库文章已不存在，请新建文章后再发布'); return false; }
      button && (button.disabled = true);
      setStatus('正在发布…');
      try {
        const response = await fetch(`${api}/api/sync`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, credentials: 'include', body: JSON.stringify({ post }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result?.message || `HTTP ${response.status}`);
        localStorage.removeItem(PENDING_CLOUD_PUBLISH_KEY);
        if (result.path) {
          const updated = { ...post, publishedPath: result.path, repositoryPending: true, orphaned: false, localEditedAt: new Date().toISOString() };
          saveDraft(updated);
          drafts = readDrafts();
          selectedId = updated.id;
          renderList();
          loadForm();
        }
        setStatus(result.commitUrl ? `发布成功：${result.commitUrl}` : '发布成功，等待 Actions 部署');
        return true;
      } catch (error) {
        setStatus(`发布失败：${error instanceof Error ? error.message : '云端请求失败'}`);
        return false;
      } finally { button && (button.disabled = false); }
    };
    const current = () => drafts.find(post => post.id === selectedId);
    const loadForm = () => {
      const post = current();
      if (!post || !form) return;
      ['id', 'title', 'description', 'pubDate', 'dir1', 'dir2', 'body', 'format'].forEach(name => { const input = field(name); if (input) input.value = post[name] || ''; });
      const tags = field('tags'); if (tags) tags.value = post.tags.join(', ');
      editedAt = post.localEditedAt || '';
      const edited = app.querySelector('[data-edited-at]'); if (edited) edited.textContent = formatEditedAt(editedAt);
      updatePreview();
    };
    const updatePreview = () => { const body = field('body'); if (preview && body) preview.innerHTML = renderMarkdown(body.value); };
    const queuePreviewUpdate = () => { editedAt = new Date().toISOString(); const edited = app.querySelector('[data-edited-at]'); if (edited) edited.textContent = formatEditedAt(editedAt); setStatus('有未保存修改'); clearTimeout(previewTimer); previewTimer = setTimeout(updatePreview, 180); };
    const renderList = () => {
      if (!list) return;
      const query = (field('search')?.value || app.querySelector('[data-search]')?.value || '').toLowerCase();
      list.innerHTML = drafts.filter(post => !post.deleted && `${post.title} ${post.tags.join(' ')} ${post.dir1} ${post.dir2}`.toLowerCase().includes(query)).map(post => `<button type="button" class="admin-post-item ${post.id === selectedId ? 'active' : ''}" data-id="${escapeHtml(post.id)}"><span>${escapeHtml(post.title || '未命名文章')}</span><small>${post.orphaned ? '待重新绑定 · ' : ''}${escapeHtml(post.dir1 || '未分类')} · ${escapeHtml(post.tags.join(', ') || '无标签')}</small></button>`).join('') || '<p class="admin-muted">暂无文章</p>';
      list.querySelectorAll('[data-id]').forEach(button => button.addEventListener('click', () => { selectedId = button.getAttribute('data-id') || ''; loadForm(); renderList(); }));
      if (count) count.textContent = `共 ${drafts.filter(post => !post.deleted).length} 篇`;
    };
    const collect = () => ({ ...current(), id: field('id')?.value || selectedId, title: field('title')?.value || '', description: field('description')?.value || '', pubDate: field('pubDate')?.value || '', dir1: field('dir1')?.value || '', dir2: field('dir2')?.value || '', tags: (field('tags')?.value || '').split(',').map(tag => tag.trim()).filter(Boolean), body: field('body')?.value || '', format: field('format')?.value || 'mdx', localEditedAt: editedAt });
    const save = () => { const post = collect(); saveDraft(post); drafts = readDrafts(); selectedId = post.id; renderList(); loadForm(); setStatus('已保存到本浏览器'); };
    form?.addEventListener('submit', event => { event.preventDefault(); save(); });
    form?.addEventListener('input', queuePreviewUpdate);
    app.querySelector('[data-search]')?.addEventListener('input', renderList);
    app.querySelector('[data-new]')?.addEventListener('click', () => { const post = { id: slugifyAdminId('未命名文章'), title: '未命名文章', description: '', pubDate: new Date().toISOString().slice(0, 10), dir1: '', dir2: '', tags: [], body: '# 新文章\n\n在这里开始写作。', format: 'mdx' }; saveDraft(post); drafts = readDrafts(); selectedId = post.id; renderList(); loadForm(); });
    const removeLocalPost = (id, keepTombstone = false) => {
      if (keepTombstone) writeDrafts(readDrafts().map(post => post.id === id ? { ...post, deleted: true } : post));
      else removeDraft(id);
      drafts = readDrafts(); selectedId = drafts.find(post => !post.deleted)?.id || ''; renderList(); loadForm();
    };
    const deleteRemotePost = async (post, button) => {
      const api = endpoint();
      if (!api || !post.publishedPath) { removeLocalPost(post.id); setStatus('已删除本地草稿'); return true; }
      button && (button.disabled = true);
      try {
        const me = await fetch(`${api}/auth/me`, { credentials: 'include' });
        if (!me.ok) {
          localStorage.setItem(PENDING_CLOUD_DELETE_KEY, JSON.stringify(post));
          window.location.href = `${api}/auth/github`;
          return false;
        }
        const auth = await me.json().catch(() => ({}));
        csrfToken = auth?.csrfToken || '';
        if (!csrfToken) throw new Error('未获取到 CSRF token');
        const response = await fetch(`${api}/api/delete`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...authHeaders() }, credentials: 'include', body: JSON.stringify({ publishedPath: post.publishedPath, title: post.title }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result?.message || `HTTP ${response.status}`);
        localStorage.removeItem(PENDING_CLOUD_DELETE_KEY);
        removeLocalPost(post.id, true);
        setStatus(result.commitUrl ? `正式文章已删除：${result.commitUrl}` : '正式文章已删除，等待 Actions 部署');
        return true;
      } catch (error) { setStatus(`删除失败：${error instanceof Error ? error.message : '云端请求失败'}`); return false; }
      finally { button && (button.disabled = false); }
    };
    const deleteButton = app.querySelector('[data-delete]');
    deleteButton?.addEventListener('click', () => { const post = current(); if (!post || !confirm(post.publishedPath ? '确定删除本地草稿并从正式网站删除这篇文章吗？' : '确定删除当前本地草稿吗？')) return; void deleteRemotePost(post, deleteButton); });
    app.querySelector('[data-reset]')?.addEventListener('click', () => { if (!confirm('将清除本浏览器中的全部草稿并恢复仓库初始内容，继续吗？')) return; resetDrafts(); drafts = readDrafts(); selectedId = drafts[0]?.id || ''; renderList(); loadForm(); setStatus('已恢复初始内容'); });
    app.querySelector('[data-export]')?.addEventListener('click', () => { const post = current(); if (!post) return; const blob = new Blob([draftToMarkdown(collect())], { type: 'text/markdown;charset=utf-8' }); const url = URL.createObjectURL(blob); const link = document.createElement('a'); link.href = url; link.download = `${post.title || 'untitled'}.${post.format}`; link.click(); URL.revokeObjectURL(url); setStatus('已导出文件'); });
    const cloudPublishButton = app.querySelector('[data-cloud-publish]');
    cloudPublishButton?.addEventListener('click', async () => {
      const api = endpoint();
      if (!api) { setStatus('尚未配置云端 API'); return; }
      const post = collect();
      if (!post.title.trim() || !post.pubDate) { setStatus('请先填写标题和发布日期'); return; }
      if (!confirm('确认通过云端提交当前文章并触发正式网站部署吗？')) return;
      try {
        const me = await fetch(`${api}/auth/me`, { credentials: 'include' });
        if (!me.ok) {
          localStorage.setItem(PENDING_CLOUD_PUBLISH_KEY, JSON.stringify(post));
          window.location.href = `${api}/auth/github`;
          return;
        }
        const auth = await me.json().catch(() => ({}));
        csrfToken = auth?.csrfToken || '';
        if (!csrfToken) throw new Error('未获取到 CSRF token');
        await publishPost(post, cloudPublishButton);
      } catch (error) { setStatus(`登录检查失败：${error instanceof Error ? error.message : '云端请求失败'}`); }
    });

    const unlocked = sessionStorage.getItem(ADMIN_UNLOCK_STORAGE_KEY) === 'true';
    if (unlocked) {
      locked?.setAttribute('hidden', '');
      editor?.removeAttribute('hidden');
    }
    renderList();
    loadForm();
    const initializeCloudSession = async () => {
      localStorage.removeItem(LEGACY_ADMIN_SESSION_KEY);
      if (!endpoint() || sessionStorage.getItem(ADMIN_UNLOCK_STORAGE_KEY) !== 'true') return;
      try {
        const me = await fetch(`${endpoint()}/auth/me`, { credentials: 'include' });
        if (!me.ok) return;
        const auth = await me.json().catch(() => ({}));
        csrfToken = auth?.csrfToken || '';
        if (!csrfToken) return;
        const pendingRaw = localStorage.getItem(PENDING_CLOUD_PUBLISH_KEY);
        if (pendingRaw) await publishPost(JSON.parse(pendingRaw), cloudPublishButton);
        const pendingDeleteRaw = localStorage.getItem(PENDING_CLOUD_DELETE_KEY);
        if (pendingDeleteRaw) await deleteRemotePost(JSON.parse(pendingDeleteRaw), deleteButton);
      } catch (error) {
        setStatus(`恢复待发布文章失败：${error instanceof Error ? error.message : '云端请求失败'}`);
      }
    };
    void initializeCloudSession();
  }
</script>
