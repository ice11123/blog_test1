---
import { ADMIN_SYNC_API_URL } from '../../consts';

const cards = [
  ['frontend', '管理台前端', '等待页面初始化'],
  ['worker', 'Cloudflare Worker', '等待连接检测'],
  ['repository', '目标仓库', '等待读取 main 分支'],
  ['deployment', 'GitHub Pages', '等待读取部署状态'],
];
---

<section class="home-status" data-public-status data-status-endpoint={ADMIN_SYNC_API_URL} aria-live="polite">
  <div class="system-status-heading">
    <div>
      <p class="status-eyebrow">LIVE STATUS</p>
      <h2>系统状态</h2>
    </div>
    <button type="button" class="status-refresh" data-public-status-refresh aria-label="重新检测系统状态">
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>重检</span>
    </button>
  </div>
  <div class="system-status-grid home-status-grid">
    {cards.map(([key, title, initial]) => (
      <article class="system-card" data-public-card={key} data-state="checking">
        <header><span class="system-dot"></span><strong>{title}</strong><span data-card-state>检测中</span></header>
        <p data-card-value>{initial}</p>
        <small data-card-detail>请稍候</small>
        <a data-card-link hidden target="_blank" rel="noopener noreferrer">查看详情</a>
      </article>
    ))}
  </div>
</section>

<style>
  .home-status,
  .home-status-grid,
  .home-status-grid .system-card {
    min-width: 0;
    box-sizing: border-box;
  }

  .home-status { width: 100%; }
  .home-status-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .home-status .system-card header { align-items: flex-start; }
  .home-status .system-card header strong {
    overflow: visible;
    line-height: 1.3;
    overflow-wrap: anywhere;
    white-space: normal;
  }
  .home-status .system-card header [data-card-state] {
    flex: 0 0 auto;
    max-width: 3.2em;
    line-height: 1.25;
    text-align: right;
    white-space: normal;
  }
  .home-status .system-card p,
  .home-status .system-card small {
    overflow: visible;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: normal;
    text-overflow: clip;
  }
  .home-status .system-status-heading { margin-bottom: .95rem; }
  .home-status .system-status-heading h2 { font-size: 1.12rem; }
  .home-status .status-eyebrow { font-size: .74rem; }
  .home-status .status-refresh { min-height: 2rem; padding: .36rem .58rem; font-size: .74rem; }
  .home-status .system-status-grid { gap: .7rem; }
  .home-status .system-card { min-height: 8.4rem; padding: .78rem .82rem; }
  .home-status .system-card header strong { font-size: .84rem; }
  .home-status .system-card header [data-card-state] { font-size: .72rem; }
  .home-status .system-card p { margin-top: .5rem; font-size: .84rem; }
  .home-status .system-card small,
  .home-status .system-card a { font-size: .72rem; }

  @media (max-width: 539px) {
    .home-status-grid { grid-template-columns: 1fr; }
    .home-status .system-card { min-height: 6.6rem; }
  }
</style>

<script src="../../scripts/public-status"></script>
